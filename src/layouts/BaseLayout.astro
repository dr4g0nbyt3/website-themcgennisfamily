---
import SEO from '../components/SEO.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import Search from '../components/Search.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  author?: string;
  breadcrumbs?: { name: string; url: string }[];
  showBreadcrumbs?: boolean;
}

const { title, description, image, type, publishedTime, author, breadcrumbs, showBreadcrumbs = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      author={author}
      breadcrumbs={breadcrumbs}
    />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXQF9S74CS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXQF9S74CS');
    </script>
  </head>
  <body class="bg-soho-white text-gray-900 font-sans">
    <!-- Navigation -->
    <nav class="bg-soho-white border-b border-gray-200 sticky top-0 z-50 backdrop-blur-sm bg-soho-white/95">
      <div class="container mx-auto px-6 py-5">
        <div class="flex justify-between items-center">
          <a href="/" class="text-2xl font-display font-bold text-gray-900 hover:text-mcgennis-gold transition-colors tracking-tight">
            The McGennis Family
          </a>
          <div class="hidden lg:flex space-x-8 items-center">
            <a href="/" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath === '/' ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Home</a>
            <a href="/start-here" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/start-here') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Start Here</a>
            <a href="/about" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/about') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>About</a>
            <a href="/family" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/family') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Family</a>
            <a href="/businesses" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/businesses') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Businesses</a>

            <!-- Blog Dropdown -->
            <div class="relative group" id="blog-dropdown">
              <a href="/blog" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 flex items-center gap-1 ${currentPath.startsWith('/blog') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>
                Blogs
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>
              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 absolute top-full left-0 mt-1 w-64 bg-soho-white rounded-lg shadow-lg border border-gray-200 z-50">
                <a href="/blog/alattetodomama" class="block px-4 py-3 text-sm text-gray-700 hover:bg-soho-white hover:text-mcgennis-maroon transition-colors">
                  <div class="font-semibold">A Latte to Do Mama</div>
                  <div class="text-xs text-gray-500">by Stephanie Kay McGennis</div>
                </a>
                <a href="/blog/entrepreneur-ai" class="block px-4 py-3 text-sm text-gray-700 hover:bg-soho-white hover:text-mcgennis-navy transition-colors">
                  <div class="font-semibold">An Entrepreneur in a World of AI</div>
                  <div class="text-xs text-gray-500">by Caleb Michael McGennis</div>
                </a>
                <a href="/blog/from-scratch-fridays" class="block px-4 py-3 text-sm text-gray-700 hover:bg-soho-white hover:text-mcgennis-forest transition-colors">
                  <div class="font-semibold">From Scratch Fridays</div>
                  <div class="text-xs text-gray-500">The Whole McGennis Family</div>
                </a>
                <a href="/blog/family-heritage" class="block px-4 py-3 text-sm text-gray-700 hover:bg-soho-white hover:text-mcgennis-gold transition-colors">
                  <div class="font-semibold">McGennis Family Heritage</div>
                  <div class="text-xs text-gray-500">by Caleb Michael McGennis</div>
                </a>
              </div>
            </div>

            <a href="/media-kit" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/media-kit') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Media Kit</a>
            <a href="/socials" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/socials') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Socials</a>
            <a href="/contact" class={`text-sm font-medium tracking-wide hover:text-mcgennis-gold transition-colors pb-1 ${currentPath.startsWith('/contact') ? 'text-mcgennis-gold border-b border-mcgennis-gold' : 'text-gray-600'}`}>Contact</a>
            <Search />
          </div>
          <!-- Mobile Menu Button -->
          <button id="mobile-menu-btn" class="lg:hidden text-gray-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden mt-4 space-y-2">
          <a href="/" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath === '/' ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Home</a>
          <a href="/start-here" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/start-here') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Start Here</a>
          <a href="/about" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/about') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>About</a>
          <a href="/family" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/family') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Family</a>
          <a href="/businesses" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/businesses') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Businesses</a>

          <!-- Mobile Blog Dropdown -->
          <div>
            <button id="mobile-blog-dropdown-btn" class={`w-full text-left py-2 hover:text-mcgennis-gold transition flex items-center justify-between ${currentPath.startsWith('/blog') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>
              Blogs
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div id="mobile-blog-dropdown-menu" class="hidden pl-4 space-y-2 mt-2">
              <a href="/blog/alattetodomama" class="block py-2 text-sm text-gray-600 hover:text-mcgennis-maroon transition">
                A Latte to Do Mama
              </a>
              <a href="/blog/entrepreneur-ai" class="block py-2 text-sm text-gray-600 hover:text-mcgennis-navy transition">
                An Entrepreneur in a World of AI
              </a>
              <a href="/blog/from-scratch-fridays" class="block py-2 text-sm text-gray-600 hover:text-mcgennis-forest transition">
                From Scratch Fridays
              </a>
              <a href="/blog/family-heritage" class="block py-2 text-sm text-gray-600 hover:text-mcgennis-forest transition">
                McGennis Family Heritage
              </a>
            </div>
          </div>

          <a href="/media-kit" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/media-kit') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Media Kit</a>
          <a href="/socials" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/socials') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Socials</a>
          <a href="/contact" class={`block py-2 hover:text-mcgennis-gold transition ${currentPath.startsWith('/contact') ? 'text-mcgennis-gold font-medium' : 'text-gray-700'}`}>Contact</a>
        </div>
      </div>
    </nav>

    <!-- Breadcrumbs -->
    {showBreadcrumbs && breadcrumbs && (
      <Breadcrumbs items={breadcrumbs.map(b => ({ label: b.name, href: b.url }))} />
    )}

    <!-- Main Content -->
    <main data-pagefind-body>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white">
      <!-- Newsletter Section -->
      <div class="border-b border-gray-800">
        <div class="container mx-auto px-4 py-12">
          <NewsletterSignup variant="centered" />
        </div>
      </div>

      <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- About -->
          <div>
            <h3 class="text-xl font-display font-bold mb-4 text-white">The McGennis Family</h3>
            <p class="text-gray-400">Building businesses and serving communities in Jefferson City, Missouri. Entrepreneurs, ministry leaders, and community builders.</p>
          </div>

          <!-- Quick Links -->
          <div>
            <h3 class="text-xl font-bold mb-4">Quick Links</h3>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/" class="hover:text-mcgennis-gold transition">Home</a></li>
              <li><a href="/about" class="hover:text-mcgennis-gold transition">About Us</a></li>
              <li><a href="/family" class="hover:text-mcgennis-gold transition">Our Family</a></li>
              <li><a href="/businesses" class="hover:text-mcgennis-gold transition">Our Businesses</a></li>
              <li><a href="/blog" class="hover:text-mcgennis-gold transition">Blog</a></li>
              <li><a href="/media-kit" class="hover:text-mcgennis-gold transition">Media Kit</a></li>
            </ul>
          </div>

          <!-- Our Businesses -->
          <div>
            <h3 class="text-xl font-bold mb-4">Our Ventures</h3>
            <ul class="space-y-2 text-gray-400">
              <li><a href="https://www.aibexp.com/" target="_blank" rel="noopener noreferrer" class="hover:text-mcgennis-gold transition">BXP</a></li>
              <li>The Honey Homestead</li>
              <li><a href="https://bearded.digital" target="_blank" rel="noopener noreferrer" class="hover:text-mcgennis-gold transition">Bearded Digital</a></li>
              <li><a href="https://www.whatstheprocessfor.com/" target="_blank" rel="noopener noreferrer" class="hover:text-mcgennis-gold transition">What's the Process for</a></li>
            </ul>
          </div>

          <!-- Social Media -->
          <div>
            <h3 class="text-xl font-bold mb-4">Connect With Us</h3>
            <div class="space-y-3">
              <a href="mailto:themcgennisfamily@gmail.com" class="flex items-center gap-2 text-gray-400 hover:text-mcgennis-gold transition" aria-label="Email The McGennis Family">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span class="text-sm">themcgennisfamily@gmail.com</span>
              </a>
              <a href="https://www.facebook.com/calebmichaelmcgennis" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-gray-400 hover:text-mcgennis-gold transition" aria-label="Caleb's Facebook">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span class="text-sm">Caleb's Facebook</span>
              </a>
              <a href="https://www.facebook.com/stephanie.davis.900388" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-gray-400 hover:text-mcgennis-gold transition" aria-label="Stephanie's Facebook">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span class="text-sm">Stephanie's Facebook</span>
              </a>
              <a href="https://www.tiktok.com/@themcgennisfamily" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-gray-400 hover:text-mcgennis-gold transition" aria-label="The McGennis Family on TikTok">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
                <span class="text-sm">Family TikTok</span>
              </a>
            </div>
            <div class="mt-4">
              <p class="text-gray-400 text-sm">Jefferson City, Missouri</p>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
          <p>&copy; {new Date().getFullYear()} The McGennis Family. All rights reserved.</p>
          <p class="mt-2 text-sm">Proudly serving Jefferson City, Missouri</p>
          <p class="mt-2 text-sm">
            <a href="/privacy-policy" class="hover:text-mcgennis-gold transition">Privacy Policy</a>
          </p>
          <p class="mt-2 text-sm"><a href="https://www.aibexp.com/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition">Website Designed and Managed by <span class="text-mcgennis-gold">BXP</span> - Custom Software & Business Growth Solutions</a></p>
        </div>
      </div>
    </footer>

    <!-- Navigation Scripts -->
    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });

      // Mobile blog dropdown
      const mobileBlogDropdownBtn = document.getElementById('mobile-blog-dropdown-btn');
      const mobileBlogDropdownMenu = document.getElementById('mobile-blog-dropdown-menu');

      mobileBlogDropdownBtn?.addEventListener('click', () => {
        mobileBlogDropdownMenu?.classList.toggle('hidden');
      });
    </script>

    <!-- Newsletter Popup (Exit Intent) -->
    <NewsletterPopup />
  </body>
</html>
