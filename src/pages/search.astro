---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search - The McGennis Family"
  description="Search The McGennis Family website for blog posts, family stories, business information, and more."
>
  <!-- Hero Section -->
  <section class="bg-soho-white py-16 md:py-24 px-4 border-b border-gray-200">
    <div class="container mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-mcgennis-gold rounded-full mb-6">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4 text-gray-900 leading-tight tracking-tight">
        Search The McGennis Family
      </h1>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-6"></div>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Find blog posts, family stories, business information, and everything else on our site.
      </p>
    </div>
  </section>

  <!-- Search Section -->
  <section class="py-12 px-4 bg-soho-white">
    <div class="container mx-auto max-w-5xl">
      <div id="pagefind-search" class="min-h-screen"></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Pagefind custom styling to match brand */
  .pagefind-ui__search-input {
    @apply w-full px-5 py-4 rounded-xl border-2 border-gray-300 focus:border-mcgennis-gold focus:ring-2 focus:ring-mcgennis-gold focus:ring-opacity-30 transition-all outline-none text-lg bg-white shadow-sm;
  }

  .pagefind-ui__search-clear {
    @apply text-gray-400 hover:text-mcgennis-maroon transition-colors;
  }

  .pagefind-ui__results {
    @apply mt-6 space-y-3;
  }

  .pagefind-ui__result {
    @apply bg-white rounded-xl py-8 pr-8 pl-10 shadow-sm hover:shadow-lg transition-all duration-300 border-l-4 border-mcgennis-gold;
  }

  .pagefind-ui__result-link {
    @apply no-underline block pl-2;
  }

  .pagefind-ui__result-title {
    @apply text-xl font-display font-bold text-gray-900 hover:text-mcgennis-gold transition-colors mb-3 leading-tight;
  }

  .pagefind-ui__result-excerpt {
    @apply text-gray-600 leading-relaxed text-base line-clamp-3;
  }

  .pagefind-ui__result-excerpt mark {
    @apply bg-mcgennis-gold bg-opacity-25 text-mcgennis-maroon font-semibold px-1.5 py-0.5 rounded;
  }

  .pagefind-ui__message {
    @apply text-gray-500 py-8 text-center text-lg;
  }

  .pagefind-ui__button {
    @apply px-6 py-3 bg-mcgennis-gold hover:bg-mcgennis-maroon text-white rounded-xl transition-all duration-300 font-medium shadow-sm hover:shadow-md;
  }

  .pagefind-ui__result-nested {
    @apply mt-4 pl-5 border-l-2 border-gray-300 space-y-2;
  }

  .pagefind-ui__result-tags {
    @apply flex gap-2 mt-4 flex-wrap;
  }

  .pagefind-ui__result-tag {
    @apply text-xs px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium;
  }
</style>

<script>
  // Initialize Pagefind UI on page load
  (function() {
    // Load Pagefind dynamically
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: "#pagefind-search",
          showSubResults: true,
          showImages: false,
          excerptLength: 15,
          resetStyles: false
        });

        // Check for query parameter and auto-search
        const urlParams = new URLSearchParams(window.location.search);
        const query = urlParams.get('q');
        if (query) {
          setTimeout(() => {
            const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
            if (input) {
              input.value = query;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input.focus();
            }
          }, 100);
        } else {
          // Focus the search input
          setTimeout(() => {
            const input = document.querySelector('.pagefind-ui__search-input');
            input?.focus();
          }, 100);
        }
      }
    };
    script.onerror = () => {
      // Pagefind not available
      const searchContainer = document.querySelector('#pagefind-search');
      if (searchContainer) {
        searchContainer.innerHTML = `
          <div class="p-8 text-center bg-white rounded-xl border-2 border-gray-200">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Search Not Available</h3>
            <p class="text-gray-600 mb-4">The search index is being built.</p>
            <p class="text-sm text-gray-500">Please try again in a moment or <a href="/" class="text-mcgennis-gold hover:text-mcgennis-maroon font-semibold">return home</a>.</p>
          </div>
        `;
      }
    };
    document.head.appendChild(script);

    // Also add CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
  })();
</script>
