---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts, CATEGORIES } from '../../data/posts';

const categories = Object.values(CATEGORIES).map((c) => ({
  ...c,
  count: posts.filter((p) => p.category.slug === c.slug).length,
}));
---

<BaseLayout
  title="McGennis Family Blog - Jefferson City, Missouri Stories & Updates"
  description="Read the latest from the McGennis family in Jefferson City, Missouri. Business insights, family updates, and stories from Caleb and Stephanie."
>
  <section class="bg-soho-white py-20 md:py-32 px-4 border-b border-gray-200">
    <div class="container mx-auto text-center max-w-4xl">
      <h1 class="text-6xl md:text-7xl font-display font-bold mb-8 text-gray-900 leading-tight tracking-tight">
        McGennis Family Blog
      </h1>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-8"></div>
      <p class="text-xl md:text-2xl max-w-3xl mx-auto text-gray-500 font-light">
        Stories, insights, and updates from a Jefferson City family building businesses and serving communities
      </p>
    </div>
  </section>

  <section class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <p class="text-xl text-gray-500 font-light">
          Welcome to our blog! Here we share stories about entrepreneurship, family life, ministry work,
          and our journey in Jefferson City, Missouri.
        </p>
      </div>

      <!-- Blog Categories -->
      <div class="max-w-7xl mx-auto">
        <!-- First Row: Stephanie & Caleb's Blogs -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <!-- Stephanie's Blog -->
          <a href="/blog/alattetodomama" class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-maroon">
            <div class="h-64 overflow-hidden relative">
              <img
                src="/images/stephanie-caleb-mcgennis-couple-jefferson-city.webp"
                alt="Stephanie Kay McGennis - A Latte to Do Mama blog"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h2 class="text-3xl font-display font-bold mb-2 tracking-tight">A Latte to Do Mama</h2>
                <p class="text-lg font-medium">by Stephanie Kay McGennis</p>
              </div>
            </div>
            <div class="p-8">
              <p class="text-gray-500 mb-6 leading-relaxed font-light">
                Real stories about motherhood, faith, and the beautiful chaos of family life. Join Stephanie as she navigates the adventures of being a mom in Jefferson City.
              </p>
              <div class="flex items-center text-mcgennis-maroon font-medium group-hover:text-mcgennis-gold transition-colors">
                Read Stephanie's Blog
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>

          <!-- Caleb's Blog -->
          <a href="/blog/entrepreneur-ai" class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-navy">
            <div class="h-64 overflow-hidden relative">
              <img
                src="/images/caleb-blog-card.webp"
                alt="Caleb Michael McGennis - An Entrepreneur in a World of AI blog"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h2 class="text-3xl font-display font-bold mb-2 tracking-tight">An Entrepreneur in a World of AI</h2>
                <p class="text-lg font-medium">by Caleb Michael McGennis</p>
              </div>
            </div>
            <div class="p-8">
              <p class="text-gray-500 mb-6 leading-relaxed font-light">
                Tech insights, entrepreneurship tips, and ministry reflections from a Jefferson City business owner and developer.
              </p>
              <div class="flex items-center text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">
                Read Caleb's Blog
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>
        </div>

        <!-- Second Row: From Scratch Fridays, Favorites & Family Heritage -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
          <!-- From Scratch Fridays -->
          <a href="/blog/from-scratch-fridays" class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-forest">
            <div class="h-64 overflow-hidden relative bg-mcgennis-forest flex items-center justify-center">
              <svg class="w-32 h-32 text-white opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h2 class="text-3xl font-display font-bold mb-2 tracking-tight">From Scratch Fridays</h2>
                <p class="text-lg font-medium">The Whole McGennis Family</p>
              </div>
            </div>
            <div class="p-8">
              <p class="text-gray-500 mb-6 leading-relaxed font-light">
                Join our family every Friday as we make delicious meals and dishes completely from scratch. Real cooking, real family time, real food.
              </p>
              <div class="flex items-center text-mcgennis-forest font-medium group-hover:text-mcgennis-gold transition-colors">
                See Our Recipes
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>

          <!-- Favorites -->
          <a href="/blog/favorites" class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-gold">
            <div class="h-64 overflow-hidden relative bg-mcgennis-gold flex items-center justify-center">
              <svg class="w-32 h-32 text-white opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h2 class="text-3xl font-display font-bold mb-2 tracking-tight">Favorites</h2>
                <p class="text-lg font-medium">Honest McGennis Reviews</p>
              </div>
            </div>
            <div class="p-8">
              <p class="text-gray-500 mb-6 leading-relaxed font-light">
                The brands the McGennis family stands behind. Pantry staples, cars, kitchen tools, small businesses &mdash; the brands we keep reaching for and would defend in conversation.
              </p>
              <div class="flex items-center text-mcgennis-gold font-medium group-hover:text-mcgennis-maroon transition-colors">
                See What We Love
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>

          <!-- Family Heritage Blog -->
          <a href="/blog/family-heritage" class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-gold">
          <div class="h-64 overflow-hidden relative bg-brass-button brightness-110 flex items-center justify-center">
            <div class="text-center text-white p-8">
              <p class="text-4xl font-display font-bold mb-2">Mag Aonghusa</p>
              <p class="text-xl italic">1150 - Present</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h2 class="text-3xl font-display font-bold mb-2 tracking-tight">McGennis Family Heritage</h2>
              <p class="text-lg font-medium">by Caleb Michael McGennis</p>
            </div>
          </div>
          <div class="p-8">
            <p class="text-gray-500 mb-6 leading-relaxed font-light">
              Exploring 875 years of family history from the Lords of Iveagh in County Down, Ireland to Jefferson City, Missouri today.
            </p>
            <div class="flex items-center text-mcgennis-forest font-medium group-hover:text-mcgennis-gold transition-colors">
              Explore Our Heritage
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </a>
        </div>
      </div>

    </div>
  </section>

  <!-- All Posts -->
  <section class="py-24 px-4 bg-soho-white border-t border-gray-200" id="all-posts">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-12">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-4 tracking-tight">
          Every Post
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-6"></div>
        <p class="text-xl text-gray-500 font-light">{posts.length} stories and counting, newest first</p>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-12" role="group" aria-label="Filter posts by blog">
        <button type="button" data-filter="all" aria-pressed="true" class="post-filter px-4 py-2 rounded-full border border-gray-300 text-sm font-medium transition-colors">
          All ({posts.length})
        </button>
        {categories.map((c) => (
          <button type="button" data-filter={c.slug} aria-pressed="false" class="post-filter px-4 py-2 rounded-full border border-gray-300 text-sm font-medium transition-colors">
            {c.name} ({c.count})
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <style>
    .post-filter[aria-pressed='true'] {
      background-color: #1B2845;
      border-color: #1B2845;
      color: #fff;
    }
    .post-filter[aria-pressed='false'] {
      color: #374151;
    }
  </style>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.post-filter');
    const cards = document.querySelectorAll<HTMLElement>('#all-posts .post-card');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        cards.forEach((card) => {
          // class, not the hidden attribute: the card's `flex` utility would override [hidden]
          card.classList.toggle('hidden', filter !== 'all' && card.dataset.category !== filter);
        });
      });
    });
  </script>
</BaseLayout>
