    <div class="container mx-auto max-w-3xl">
      <h3 class="text-2xl font-display font-bold mb-8 text-gray-900 tracking-tight text-center">Related Stories</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/blog/entrepreneur-ai/the-mountain-mover" class="group bg-soho-white p-6 rounded-2xl border border-gray-200 hover:border-mcgennis-navy hover:shadow-lg transition-all duration-300">
          <h4 class="text-xl font-display font-bold mb-2 text-gray-900 group-hover:text-mcgennis-navy transition-colors">The Mountain Mover</h4>
          <p class="text-gray-600 mb-4">When God doesn't just move mountains. He chews them up and spits them out.</p>
          <span class="text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">Read More &rarr;</span>
        </a>
        <a href="/blog/entrepreneur-ai/church-and-business-overlap" class="group bg-soho-white p-6 rounded-2xl border border-gray-200 hover:border-mcgennis-navy hover:shadow-lg transition-all duration-300">
          <h4 class="text-xl font-display font-bold mb-2 text-gray-900 group-hover:text-mcgennis-navy transition-colors">Church and Business Overlap</h4>
          <p class="text-gray-600 mb-4">What happens when the skills God gave you for ministry are the same ones He wants you to use in business.</p>
          <span class="text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">Read More &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Back to Blog -->
  <section class="py-16 px-4">
    <div class="container mx-auto text-center">
      <a href="/blog/entrepreneur-ai" class="inline-flex items-center px-6 py-3 rounded-xl border border-gray-300 text-gray-700 font-medium tracking-wide hover:border-mcgennis-navy hover:text-mcgennis-navy transition-all duration-300">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to All Posts
      </a>
    </div>
  </section>
</BaseLayout>