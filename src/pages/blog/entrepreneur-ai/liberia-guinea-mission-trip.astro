        <button type="button" data-lb-prev class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 text-white text-2xl" aria-label="Previous photo">&#8249;</button>
        <button type="button" data-lb-next class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 text-white text-2xl" aria-label="Next photo">&#8250;</button>
        <figure class="h-full flex flex-col items-center justify-center px-14 py-16 m-0">
          <img data-lb-img src="" alt="" class="max-h-full max-w-full object-contain rounded-lg" />
          <figcaption class="mt-4 text-center text-sm text-gray-200"><span data-lb-caption></span> <span data-lb-count class="text-gray-400 ml-2"></span></figcaption>
        </figure>
      </div>

      <script>
        const items = Array.from(document.querySelectorAll<HTMLElement>('#trip-gallery [data-gallery-item]'));
        const lb = document.getElementById('gallery-lightbox')!;
        const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
        const lbCap = lb.querySelector('[data-lb-caption]')!;
        const lbCount = lb.querySelector('[data-lb-count]')!;
        let current = 0;

        function show(i: number) {
          current = (i + items.length) % items.length;
          const img = items[current].querySelector('img')!;
          lbImg.src = img.src;
          lbImg.alt = img.alt;
          lbCap.textContent = items[current].querySelector('figcaption')?.textContent ?? '';
          lbCount.textContent = `${current + 1} / ${items.length}`;
        }
        function open(i: number) {
          show(i);
          lb.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          lb.classList.add('hidden');
          document.body.style.overflow = '';
        }

        items.forEach((item, i) => {
          item.querySelector('[data-gallery-link]')?.addEventListener('click', (e) => {
            e.preventDefault();
            open(i);
          });
        });
        lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
        lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
        lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
        lb.addEventListener('click', (e) => { if (e.target === lb || (e.target as HTMLElement).tagName === 'FIGURE') close(); });
        document.addEventListener('keydown', (e) => {
          if (lb.classList.contains('hidden')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') show(current - 1);
          if (e.key === 'ArrowRight') show(current + 1);
        });
        let touchX = 0;
        lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend', (e) => {
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
        });
      </script>

