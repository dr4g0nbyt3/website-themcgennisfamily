  image="/images/social/support-amazon-og-card.jpg"
>
  <!-- Hero Section -->
  <section class="bg-soho-white py-20 md:py-32 px-4 border-b border-gray-200">
    <div class="container mx-auto max-w-4xl">
      <a href="/blog/entrepreneur-ai" class="inline-flex items-center text-mcgennis-navy hover:text-mcgennis-gold transition-colors mb-8">
