---
import BaseLayout from '../../layouts/BaseLayout.astro';

const blogPosts = [
  {
    title: "Masu Black Walnut Chopsticks: The Pair We Actually Reach For",
    slug: "masu-black-walnut-chopsticks",
    excerpt: "Masu is a trusted brand we've been using all year — black walnut chopsticks with decorative thread, in a wooden gift box. The pair we reach for at every dumpling night, sushi roll, and bowl of pho. Honest review with our affiliate code.",
    date: "May 9, 2026",
    category: "Kitchen",
    image: "/images/chopsticks-in-the-desktop.webp"
  },
  {
    title: "Why I'm a Nissan Guy: The JDM Lineage I'd Defend With My Life",
    slug: "why-im-a-nissan-guy-jdm-lineage",
    excerpt: "From the 1969 Hakosuka GTR to the R34, the 240Z to the S15, the unrealized MID4 to the Le Mans R390 — a love letter to Nissan and the Japanese process philosophy (monozukuri, kaizen, shokunin) that produced the most cohesive lineage in automotive history.",
    date: "April 28, 2026",
    category: "Cars",
    image: "/images/social/nissan-jdm-og-card.jpg"
  },
  {
    title: "Lao Gan Ma Spicy Chili Crisp: The Jar I Keep In My Car",
    slug: "lao-gan-ma-spicy-chili-crisp",
    excerpt: "I literally keep a jar of Lao Gan Ma in my car. The +5 rule: take any meal you eat, add a spoonful of this chili crisp, and the rating jumps five points. Here's why.",
    date: "April 28, 2026",
    category: "Pantry",
    image: "/images/lao-gan-ma-spicy-chili-crisp.webp"
  },
  {
    title: "Skin and Bone Sardines: The Tin That Changed My Mind About Sardines",
    slug: "skin-and-bone-sardines",
    excerpt: "We don't normally do sardines. Then we tried Skin and Bone — Portuguese, hand-packed, three-ingredient — and now there's a stack of them in our pantry. Here's the honest review.",
    date: "April 28, 2026",
    category: "Pantry",
    image: "/images/skin-and-bone/tin-and-box.webp"
  }
];
---

<BaseLayout
  title="Favorites - The McGennis Family"
  description="The McGennis family's honest reviews of products, brands, and small businesses we actually love. Pantry finds, kitchen tools, kid gear, and more from Jefferson City."
  type="website"
>
  <!-- Hero Section -->
  <section class="bg-soho-white py-20 md:py-32 px-4 border-b border-gray-200">
    <div class="container mx-auto text-center max-w-4xl">
      <h1 class="text-6xl md:text-7xl font-display font-bold mb-8 text-gray-900 leading-tight tracking-tight">
        Favorites
      </h1>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-8"></div>
      <p class="text-xl md:text-2xl text-gray-600 mb-6 font-light leading-relaxed">
        The brands the McGennis family stands behind
      </p>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto font-light">
        The pantry staples, the cars, the kitchen tools, and the small businesses that have earned our loyalty. The kind of brands you'd defend in a conversation. The ones we keep coming back to.
      </p>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="py-16 px-4">
    <div class="container mx-auto max-w-4xl">
      <div class="space-y-8">
        {blogPosts.map((post) => (
          <a href={`/blog/favorites/${post.slug}`} class="group block bg-soho-white rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-gold overflow-hidden">
            {post.image && (
              <div class="h-64 overflow-hidden">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-8">
              <div class="flex items-center gap-2 mb-4">
                <span class="inline-block px-3 py-1 bg-mcgennis-gold bg-opacity-10 text-mcgennis-gold text-xs font-semibold rounded-full">
                  {post.category}
                </span>
                <span class="text-sm text-gray-400">{post.date}</span>
              </div>
              <h2 class="text-3xl font-display font-bold text-gray-900 mb-3 group-hover:text-mcgennis-gold transition-colors tracking-tight">
                {post.title}
              </h2>
              <p class="text-gray-600 leading-relaxed mb-4 font-light">
                {post.excerpt}
              </p>
              <span class="text-mcgennis-gold font-medium group-hover:text-mcgennis-maroon transition-colors">
                Read More &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About Favorites -->
  <section class="py-16 px-4 bg-soho-white">
    <div class="container mx-auto max-w-3xl">
      <div class="bg-soho-white border border-gray-200 rounded-2xl p-8 md:p-12">
        <div class="flex items-center justify-center mb-6">
          <svg class="w-16 h-16 text-mcgennis-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h3 class="text-3xl font-display font-bold mb-6 text-gray-900 tracking-tight text-center">
          What Makes a Favorite
        </h3>
        <div class="prose prose-lg max-w-none">
          <p class="text-gray-600 leading-relaxed mb-4 font-light">
            A favorite is a brand we'd recommend to a friend without hesitation &mdash; the kind we keep reaching for, keep reordering, and keep talking about. If we paid for it, we'll say we paid for it. If we're an affiliate, we'll disclose that up top. If a brand sent us a sample, we'll say that too &mdash; and you'll still get the honest take. If we don't love it, we don't write about it.
          </p>
          <p class="text-gray-600 leading-relaxed font-light">
            Expect pantry staples, kitchen tools, kid gear, cars (Caleb's a JDM Nissan guy), books, small businesses, and the occasional weird find that has earned a permanent spot in our home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Back to Blog -->
  <section class="py-16 px-4">
    <div class="container mx-auto text-center">
      <a href="/blog" class="inline-flex items-center px-6 py-3 rounded-xl border border-gray-300 text-gray-700 font-medium tracking-wide hover:border-mcgennis-gold hover:text-mcgennis-gold transition-all duration-300">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to All Blogs
      </a>
    </div>
  </section>
</BaseLayout>
