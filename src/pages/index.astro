---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const latestPosts = posts.slice(0, 3);

const hero = '/images/mcgennis-family-stephanie-caleb-leonardo-jefferson-city';
const heroSrcset = `${hero}-640w.webp 640w, ${hero}-960w.webp 960w, ${hero}.webp 1365w`;
const heroSizes = '(min-width: 1280px) 600px, (min-width: 1024px) 45vw, calc(100vw - 2rem)';
---

<BaseLayout
  title="The McGennis Family - Building Businesses and Serving Communities in Jefferson City"
  description="Meet the McGennis family - entrepreneurs and ministry leaders making an impact in Jefferson City, Missouri. Led by Caleb & Stephanie McGennis."
>
  <link slot="head" rel="preload" as="image" href={`${hero}-960w.webp`} imagesrcset={heroSrcset} imagesizes={heroSizes} fetchpriority="high" />
  <!-- Hero Section with Real Photo -->
  <section class="relative bg-soho-white py-20 md:py-32 px-4 overflow-x-clip">
    <div class="container mx-auto max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Text Content -->
        <div class="order-2 lg:order-1 lg:pt-16">
          <p class="text-sm tracking-widest text-mcgennis-gold font-light mb-4 uppercase">Est. 2020 • Forged 1150</p>
          <h1 class="text-6xl md:text-7xl font-display font-bold mb-6 text-gray-900 leading-tight tracking-tight">
            The McGennis<br/>Family
          </h1>
          <p class="text-lg md:text-xl italic text-mcgennis-gold font-light mb-8 tracking-wide">
            Sola Salus Servire Deo <span class="text-base opacity-75">— In the Service of God</span>
          </p>
          <p class="text-xl md:text-2xl mb-10 text-gray-600 font-light leading-relaxed">
            Entrepreneurs, Ministry Leaders & Community Builders making a lasting impact in Central Missouri
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/family" class="group inline-flex items-center justify-center px-8 py-4 bg-brass-button brightness-110 text-white font-medium tracking-wide transition-all duration-300 shadow-md hover:shadow-lg rounded-xl">
              Meet Our Family
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/businesses" class="inline-flex items-center justify-center px-8 py-4 rounded-xl border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md">
              Our Businesses
            </a>
          </div>
        </div>

        <!-- Family Photo -->
        <div class="order-1 lg:order-2">
          <div class="relative">
            <!-- Metallic brass border -->
            <div class="p-5 rounded-3xl bg-brass-metal brightness-110 shadow-2xl">
              <img
                src="/images/mcgennis-family-stephanie-caleb-leonardo-jefferson-city-960w.webp"
                srcset={heroSrcset}
                sizes={heroSizes}
                alt="The McGennis Family - Stephanie, Caleb, and Leonardo McGennis in Jefferson City, Missouri"
                class="w-full h-auto rounded-2xl"
                width="1365"
                height="2048"
                fetchpriority="high"
              />
            </div>
            <!-- Decorative accent with brass effect -->
            <div class="absolute -bottom-6 -right-6 w-full h-full rounded-3xl bg-brass-metal opacity-30 -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Family Introduction -->
  <section class="py-24 px-4 bg-soho-white">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-4 tracking-tight">
          Meet The McGennis Family
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full mx-auto mb-6 shadow-sm"></div>
        <p class="text-lg text-mcgennis-gold italic mb-3 font-light">
          In the Service of God
        </p>
        <p class="text-xl text-gray-500 max-w-2xl mx-auto font-light">
          A family dedicated to entrepreneurship, faith, and making a lasting impact in Jefferson City, Missouri
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Caleb -->
        <div class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-navy rounded-2xl">
          <div class="h-72 overflow-hidden relative">
            <img
              src="/images/caleb-mcgennis-sports-crusaders-jefferson-city.webp"
              alt="Caleb Michael McGennis, entrepreneur and founder in Jefferson City, Missouri"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1 text-gray-900 tracking-tight">Caleb Michael</h3>
            <p class="text-sm text-gray-500 mb-1 font-medium">Founder & Entrepreneur</p>
            <p class="text-xs text-gray-400 mb-4">Also known as dr4g0nbyt3</p>
            <a href="/family/caleb" class="inline-flex items-center text-sm font-medium text-mcgennis-navy hover:text-mcgennis-gold transition-colors">
              Meet Caleb
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Stephanie -->
        <div class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-maroon rounded-2xl">
          <div class="h-72 overflow-hidden relative">
            <img
              src="/images/stephanie-caleb-mcgennis-couple-jefferson-city.webp"
              alt="Stephanie Kay McGennis, co-founder and family leader in Jefferson City, Missouri"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1 text-gray-900 tracking-tight">Stephanie Kay</h3>
            <p class="text-sm text-gray-500 mb-1 font-medium">Co-Founder</p>
            <p class="text-xs text-gray-400 mb-4">Family & Business Partner</p>
            <a href="/family/stephanie" class="inline-flex items-center text-sm font-medium text-mcgennis-maroon hover:text-mcgennis-gold transition-colors">
              Meet Stephanie
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Leonardo -->
        <div class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-forest rounded-2xl">
          <div class="h-72 overflow-hidden relative">
            <img
              src="/images/leonardo-mcgennis-portrait-jefferson-city.webp"
              alt="Leonardo Bryton McGennis, son of the McGennis family in Jefferson City"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1 text-gray-900 tracking-tight">Leonardo Bryton</h3>
            <p class="text-sm text-gray-500 mb-1 font-medium">McGennis Son</p>
            <p class="text-xs text-gray-400 mb-4">Future Leader</p>
            <a href="/family/leonardo" class="inline-flex items-center text-sm font-medium text-mcgennis-forest hover:text-mcgennis-gold transition-colors">
              Meet Leonardo
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Raphael -->
        <div class="group bg-soho-white overflow-hidden rounded-2xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-gold rounded-2xl">
          <div class="h-72 overflow-hidden relative">
            <img
              src="/images/raphael-mcgennis-baby-sleeping-jefferson-city.webp"
              alt="Raphael Corwyn McGennis, youngest son of the McGennis family"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1 text-gray-900 tracking-tight">Raphael Corwyn</h3>
            <p class="text-sm text-gray-500 mb-1 font-medium">McGennis Son</p>
            <p class="text-xs text-gray-400 mb-4">Future Leader</p>
            <a href="/family/raphael" class="inline-flex items-center text-sm font-medium text-mcgennis-navy hover:text-mcgennis-gold transition-colors">
              Meet Raphael
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Businesses Section -->
  <section class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-4 tracking-tight">
          Our Business Ventures
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full mx-auto mb-6 shadow-sm"></div>
        <p class="text-xl text-gray-500 max-w-3xl mx-auto font-light">
          Building businesses and creating value in Jefferson City and beyond
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- BXP -->
        <div class="group bg-soho-white p-8 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-navy rounded-2xl">
          <div class="mb-6">
            <svg class="w-14 h-14 text-mcgennis-navy group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2 text-gray-900 tracking-tight">BXP</h3>
          <p class="text-gray-500 leading-relaxed">Leading innovation and technology solutions</p>
        </div>

        <!-- The Honey Homestead -->
        <div class="group bg-soho-white p-8 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-gold rounded-2xl">
          <div class="mb-6">
            <svg class="w-14 h-14 text-mcgennis-gold group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2 text-gray-900 tracking-tight">The Honey Homestead</h3>
          <p class="text-gray-500 leading-relaxed">Natural honey and homestead products</p>
        </div>

        <!-- What's the Process for -->
        <a href="https://www.whatstheprocessfor.com/" target="_blank" rel="noopener noreferrer" class="group bg-soho-white p-8 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-forest rounded-2xl block">
          <div class="mb-6">
            <svg class="w-14 h-14 text-mcgennis-forest group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2 text-gray-900 tracking-tight">What's the Process for</h3>
          <p class="text-gray-500 leading-relaxed">Simplifying processes and procedures</p>
        </a>

        <!-- Bearded Digital -->
        <a href="https://bearded.digital" target="_blank" rel="noopener noreferrer" class="group bg-soho-white p-8 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-purple rounded-2xl block">
          <div class="mb-6">
            <svg class="w-14 h-14 text-mcgennis-purple group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2 text-gray-900 tracking-tight">Bearded Digital</h3>
          <p class="text-gray-500 leading-relaxed">Church website design company helping churches reach their demographic</p>
        </a>
      </div>

      <div class="text-center mt-16">
        <a href="/businesses" class="group inline-flex items-center px-8 py-4 border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md rounded-xl">
          Explore All Businesses
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest from the Blog -->
  <section class="py-24 px-4 bg-soho-white">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-4 tracking-tight">
          Latest from the Blog
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full mx-auto mb-6 shadow-sm"></div>
        <p class="text-xl text-gray-500 max-w-3xl mx-auto font-light">
          Stories, insights, and reflections from the McGennis family
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>

      <div class="text-center mt-12">
        <a href="/blog" class="group inline-flex items-center px-8 py-4 border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md rounded-xl">
          Explore All Blog Posts
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Ministry & Community -->
  <section class="py-24 px-4 bg-soho-white">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold text-gray-900 mb-4 tracking-tight">
          Ministry & Community Impact
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full mx-auto mb-6 shadow-sm"></div>
        <p class="text-xl text-gray-500 max-w-3xl mx-auto font-light">
          Serving Jefferson City through faith and community engagement
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="group bg-soho-white p-8 text-center hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-maroon rounded-2xl">
          <div class="flex justify-center mb-6">
            <svg class="w-14 h-14 text-mcgennis-maroon group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900 tracking-tight">Sports Crusaders</h3>
          <p class="text-gray-500 leading-relaxed">Active ministry member spreading faith through sports</p>
        </div>

        <div class="group bg-soho-white p-8 text-center hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-navy rounded-2xl">
          <div class="flex justify-center mb-6">
            <svg class="w-14 h-14 text-mcgennis-navy group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900 tracking-tight">Missouri Baptist Convention</h3>
          <p class="text-gray-500 leading-relaxed">5 years as A/V and computer specialist</p>
        </div>

        <div class="group bg-soho-white p-8 text-center hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-forest rounded-2xl">
          <div class="flex justify-center mb-6">
            <svg class="w-14 h-14 text-mcgennis-forest group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900 tracking-tight">Concord Baptist Church</h3>
          <p class="text-gray-500 leading-relaxed">1 year as media director</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-24 px-4 bg-soho-white border-t border-gray-200">
    <div class="container mx-auto text-center max-w-4xl">
      <h2 class="text-5xl font-display font-bold mb-4 text-gray-900 tracking-tight">
        Connect With The McGennis Family
      </h2>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-8"></div>
      <p class="text-xl mb-12 max-w-2xl mx-auto text-gray-500 font-light">
        Follow our journey as we build businesses, serve our community, and make Jefferson City proud
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="group inline-flex items-center justify-center px-8 py-4 bg-brass-button brightness-110 text-white font-medium tracking-wide transition-all duration-300 shadow-md hover:shadow-lg rounded-xl">
          Get In Touch
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/blog" class="inline-flex items-center justify-center px-8 py-4 rounded-xl border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md">
          Read Our Blog
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
