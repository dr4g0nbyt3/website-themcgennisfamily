---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LEAD_MAGNET } from '../data/leadMagnet';
---

<BaseLayout
  title="You're In! | The McGennis Family"
  description="Thank you for subscribing — your free download is ready below."
  type="website"
>
  <section class="bg-soho-white py-32 px-4">
    <div class="container mx-auto max-w-2xl text-center">
      <div class="bg-soho-white rounded-2xl shadow-lg p-12">
        <!-- Success Icon -->
        <div class="flex justify-center mb-8">
          <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center">
            <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
        </div>

        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4 text-gray-900 tracking-tight">
          Welcome to the Family!
        </h1>

        <div class="h-1 w-24 bg-brass-horizontal rounded-full mx-auto mb-8 shadow-sm"></div>

        {LEAD_MAGNET.enabled && (
          <div class="bg-gradient-to-br from-mcgennis-maroon/5 to-mcgennis-gold/10 border-2 border-mcgennis-gold/20 rounded-2xl p-8 mb-8">
            <p class="uppercase tracking-widest text-xs font-semibold text-mcgennis-maroon mb-2">
              Your Free Download
            </p>
            <h2 class="text-2xl md:text-3xl font-display font-bold text-gray-900 mb-3">
              {LEAD_MAGNET.title}
            </h2>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {LEAD_MAGNET.hook}
            </p>

            <a
              href={LEAD_MAGNET.fileUrl}
              download={LEAD_MAGNET.fileName}
              class="inline-flex items-center gap-2 px-8 py-4 bg-mcgennis-maroon hover:bg-mcgennis-gold text-white font-medium rounded-lg shadow-md hover:shadow-lg transition-all duration-300"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Download the PDF
            </a>

            <p class="text-xs text-gray-500 mt-4">
              Trouble downloading? Email us at <a href="mailto:themcgennisfamily@gmail.com" class="text-mcgennis-maroon hover:underline">themcgennisfamily@gmail.com</a> and we'll send it over.
            </p>
          </div>
        )}

        <p class="text-lg text-gray-500 mb-8 leading-relaxed">
          You'll also receive weekly encouragement, recipes, and practical wisdom from our family to yours.
          Keep an eye on your inbox.
        </p>

        <div class="bg-soho-white rounded-xl p-6 mb-8 border border-gray-100">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">What's Next?</h2>
          <ul class="text-left text-gray-600 space-y-2">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-mcgennis-gold mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Check your email inbox for a confirmation message</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-mcgennis-gold mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Add our email to your contacts so you never miss an update</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-mcgennis-gold mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Expect your first newsletter within the week</span>
            </li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="group inline-flex items-center justify-center px-8 py-4 bg-brass-button brightness-110 text-white font-medium tracking-wide transition-all duration-300 shadow-md hover:shadow-lg rounded-xl">
            Back to Home
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/blog" class="inline-flex items-center justify-center px-8 py-4 rounded-xl border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md">
            Read Our Blog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
