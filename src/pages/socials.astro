---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connect With The McGennis Family - Social Media & Links"
  description="Follow the McGennis family on social media, read our blogs, explore our businesses, and connect with us across the web."
  image="/images/mcgennis-family-stephanie-caleb-leonardo-jefferson-city.jpg"
>
  <div class="min-h-screen bg-gradient-to-br from-soho-white via-white to-gray-50">
    <!-- Hero Section with Family Photo -->
    <section class="pt-12 pb-8 px-4">
      <div class="container mx-auto max-w-2xl text-center">
        <!-- Family Photo Circle -->
        <div class="mb-3 inline-block">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-white shadow-2xl mx-auto">
            <img
              src="/images/mcgennis-family-stephanie-caleb-leonardo-jefferson-city.jpg"
              alt="The McGennis Family"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- EST. 2020 Pill -->
        <div class="mb-6">
          <div class="inline-block bg-mcgennis-gold text-white px-4 py-1 rounded-full text-xs font-bold shadow-lg">
            EST. 2020
          </div>
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-3 text-gray-900 tracking-tight">
          The McGennis Family
        </h1>
        <p class="text-lg text-gray-600 mb-2 font-light italic">
          Sola Salus Servire Deo
        </p>
        <p class="text-base text-gray-500 font-light max-w-md mx-auto">
          Entrepreneurs, Ministry Leaders & Community Builders in Jefferson City, Missouri
        </p>
      </div>
    </section>

    <!-- Main Links Section -->
    <section class="pb-12 px-4">
      <div class="container mx-auto max-w-2xl">
        <div class="space-y-4">

          <!-- Website Link -->
          <a href="/" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-gold">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-brass-button brightness-110 rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-gold transition-colors">Our Website</h3>
                <p class="text-sm text-gray-500">themcgennisfamily.com</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Section: Social Media -->
          <div class="pt-4">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 px-2">Follow Us</h2>
          </div>

          <!-- Family TikTok -->
          <a href="https://www.tiktok.com/@themcgennisfamily" target="_blank" rel="noopener noreferrer" class="group block bg-brass-button brightness-110 rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-white">Family TikTok</h3>
                <p class="text-sm text-white/80">@themcgennisfamily</p>
              </div>
              <svg class="w-5 h-5 text-white/80 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Caleb's Facebook -->
          <a href="https://www.facebook.com/calebmichaelmcgennis" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-navy">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-navy rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-navy transition-colors">Caleb's Facebook</h3>
                <p class="text-sm text-gray-500">Follow Caleb</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-navy group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Stephanie's Facebook -->
          <a href="https://www.facebook.com/stephanie.davis.900388" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-maroon">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-maroon rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-maroon transition-colors">Stephanie's Facebook</h3>
                <p class="text-sm text-gray-500">Follow Stephanie</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-maroon group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Section: Blogs -->
          <div class="pt-4">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 px-2">Read Our Stories</h2>
          </div>

          <!-- An Entrepreneur in a World of AI -->
          <a href="/blog/entrepreneur-ai" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-navy">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-navy rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-navy transition-colors">An Entrepreneur in a World of AI</h3>
                <p class="text-sm text-gray-500">Caleb's business & tech blog</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-navy group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- A Latte to Do Mama -->
          <a href="/blog/alattetodomama" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-maroon">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-maroon rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-maroon transition-colors">A Latte to Do Mama</h3>
                <p class="text-sm text-gray-500">Stephanie's motherhood blog</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-maroon group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- From Scratch Fridays -->
          <a href="/blog/from-scratch-fridays" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-forest">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-forest rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-forest transition-colors">From Scratch Fridays</h3>
                <p class="text-sm text-gray-500">Weekly cooking adventures</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-forest group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Family Heritage -->
          <a href="/blog/family-heritage" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-gold">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-gold rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-gold transition-colors">Family Heritage</h3>
                <p class="text-sm text-gray-500">875 years of McGennis history</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Section: Our Businesses -->
          <div class="pt-4">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 px-2">Our Ventures</h2>
          </div>

          <!-- BXP -->
          <a href="https://www.aibexp.com/" target="_blank" rel="noopener noreferrer" class="group block bg-gradient-to-r from-mcgennis-navy to-blue-900 rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-mcgennis-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-white">BXP</h3>
                <p class="text-sm text-white/80">Technology & Innovation</p>
              </div>
              <svg class="w-5 h-5 text-white/80 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Bearded Digital -->
          <a href="https://bearded.digital" target="_blank" rel="noopener noreferrer" class="group block bg-gradient-to-r from-mcgennis-purple to-purple-900 rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-mcgennis-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-white">Bearded Digital</h3>
                <p class="text-sm text-white/80">Church Website Design</p>
              </div>
              <svg class="w-5 h-5 text-white/80 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- What's the Process for -->
          <a href="https://www.whatstheprocessfor.com/" target="_blank" rel="noopener noreferrer" class="group block bg-gradient-to-r from-mcgennis-forest to-green-900 rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-mcgennis-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-white">What's the Process for</h3>
                <p class="text-sm text-white/80">Process Management</p>
              </div>
              <svg class="w-5 h-5 text-white/80 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Section: More -->
          <div class="pt-4">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 px-2">More</h2>
          </div>

          <!-- Newsletter -->
          <a href="/#newsletter" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-gold">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-gold rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-gold transition-colors">Newsletter</h3>
                <p class="text-sm text-gray-500">Get weekly updates</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Contact -->
          <a href="/contact" class="group block bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-mcgennis-navy">
            <div class="flex items-center gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-mcgennis-navy rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-mcgennis-navy transition-colors">Get In Touch</h3>
                <p class="text-sm text-gray-500">Contact us</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-mcgennis-navy group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- Footer -->
    <section class="py-12 px-4">
      <div class="container mx-auto max-w-2xl text-center">
        <p class="text-sm text-gray-500 mb-4">
          <span class="font-medium text-gray-700">Jefferson City, Missouri</span>
        </p>
        <p class="text-xs text-gray-400">
          © {new Date().getFullYear()} The McGennis Family. All rights reserved.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom gradient animations */
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
