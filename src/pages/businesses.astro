---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="McGennis Family Businesses - Jefferson City, Missouri Entrepreneurs"
  description="Explore BXP, The Honey Homestead, and more businesses founded by Caleb McGennis in Jefferson City, Missouri. Innovation meets entrepreneurship."
>
  <section class="bg-soho-white py-20 md:py-32 px-4 border-b border-gray-200">
    <div class="container mx-auto text-center max-w-4xl">
      <h1 class="text-6xl md:text-7xl font-display font-bold mb-8 text-gray-900 leading-tight tracking-tight">
        Our Business Ventures
      </h1>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-8"></div>
      <p class="text-xl md:text-2xl max-w-3xl mx-auto text-gray-500 font-light">
        Building diverse businesses and creating value in Jefferson City and beyond
      </p>
    </div>
  </section>

  <section class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <p class="text-xl text-gray-500 max-w-3xl mx-auto font-light">
          Founded and operated by <a href="/family/caleb" class="text-mcgennis-navy font-medium hover:text-mcgennis-gold transition">Caleb Michael McGennis</a>,
          these businesses represent innovation, quality, and commitment to excellence in Central Missouri.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- BXP -->
        <a href="https://www.aibexp.com/" target="_blank" rel="noopener noreferrer" class="group bg-soho-white p-10 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-navy">
          <div class="mb-6">
            <svg class="w-16 h-16 text-mcgennis-navy group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h2 class="text-3xl font-display font-bold mb-4 text-gray-900 tracking-tight group-hover:text-mcgennis-navy transition-colors">BXP</h2>
          <div class="space-y-3 text-gray-500">
            <p class="text-lg font-medium text-gray-700">
              Technology & Innovation
            </p>
            <p class="leading-relaxed">
              BXP leads the way in technology solutions and innovation services. We provide cutting-edge solutions
              for businesses looking to modernize and scale their operations in the digital age.
            </p>
            <div class="pt-4">
              <span class="inline-block bg-mcgennis-navy text-white px-4 py-2 rounded-md text-sm font-medium">
                Technology
              </span>
              <span class="inline-block bg-gray-100 text-gray-700 px-4 py-2 rounded-md text-sm font-medium ml-2">
                Innovation
              </span>
              <span class="inline-flex items-center text-mcgennis-navy font-medium text-sm mt-2">
                Visit Website →
              </span>
            </div>
          </div>
        </a>

        <!-- The Honey Homestead -->
        <div class="group bg-soho-white p-10 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-gold">
          <div class="mb-6">
            <svg class="w-16 h-16 text-mcgennis-gold group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h2 class="text-3xl font-display font-bold mb-4 text-gray-900 tracking-tight">The Honey Homestead</h2>
          <div class="space-y-3 text-gray-500">
            <p class="text-lg font-medium text-gray-700">
              Agriculture & Natural Products
            </p>
            <p class="leading-relaxed">
              The Honey Homestead produces premium natural honey and homestead products. We're committed to sustainable
              practices and delivering pure, high-quality products to Jefferson City and surrounding communities.
            </p>
            <div class="pt-4">
              <span class="inline-block bg-brass-button brightness-110 text-white px-4 py-2 rounded-md text-sm font-medium">
                Natural Products
              </span>
              <span class="inline-block bg-gray-100 text-gray-700 px-4 py-2 rounded-md text-sm font-medium ml-2">
                Sustainable
              </span>
            </div>
          </div>
        </div>

        <!-- Bearded Digital -->
        <a href="https://bearded.digital" target="_blank" rel="noopener noreferrer" class="group bg-soho-white p-10 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-purple">
          <div class="mb-6">
            <svg class="w-16 h-16 text-mcgennis-purple group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h2 class="text-3xl font-display font-bold mb-4 text-gray-900 tracking-tight group-hover:text-mcgennis-purple transition-colors">Bearded Digital</h2>
          <div class="space-y-3 text-gray-500">
            <p class="text-lg font-medium text-gray-700">
              Church Website Design
            </p>
            <p class="leading-relaxed">
              Helping churches reach their demographic through professional website design and digital presence.
              We create engaging, accessible websites that help ministries connect with their communities and spread the gospel.
            </p>
            <div class="pt-4">
              <span class="inline-block bg-mcgennis-purple text-white px-4 py-2 rounded-md text-sm font-medium">
                Church Websites
              </span>
              <span class="inline-block bg-gray-100 text-gray-700 px-4 py-2 rounded-md text-sm font-medium ml-2">
                Ministry
              </span>
              <span class="inline-flex items-center text-mcgennis-purple font-medium text-sm mt-2">
                Visit Website →
              </span>
            </div>
          </div>
        </a>

        <!-- What's the Process for -->
        <a href="https://www.whatstheprocessfor.com/" target="_blank" rel="noopener noreferrer" class="group bg-soho-white p-10 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl hover:border-mcgennis-forest">
          <div class="mb-6">
            <svg class="w-16 h-16 text-mcgennis-forest group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h2 class="text-3xl font-display font-bold mb-4 text-gray-900 tracking-tight group-hover:text-mcgennis-forest transition-colors">What's the Process for</h2>
          <div class="space-y-3 text-gray-500">
            <p class="text-lg font-medium text-gray-700">
              Process Management & Documentation
            </p>
            <p class="leading-relaxed">
              Simplifying complex processes and making procedures accessible to everyone. We help businesses and
              individuals understand and document workflows, making operations more efficient and transparent.
            </p>
            <div class="pt-4">
              <span class="inline-block bg-mcgennis-forest text-white px-4 py-2 rounded-md text-sm font-medium">
                Process Management
              </span>
              <span class="inline-block bg-gray-100 text-gray-700 px-4 py-2 rounded-md text-sm font-medium ml-2">
                Documentation
              </span>
              <span class="inline-flex items-center text-mcgennis-forest font-medium text-sm mt-2">
                Visit Website →
              </span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Business Insights Blog -->
  <section class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-display font-bold mb-4 text-gray-900 tracking-tight">
          Business Insights & Stories
        </h2>
        <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-6"></div>
        <p class="text-xl text-gray-500 max-w-3xl mx-auto font-light">
          Read about our entrepreneurial journey, business lessons, and insights from building ventures in Jefferson City
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Thriving Businesses Post -->
        <a href="/blog/entrepreneur-ai/thriving-businesses-jefferson-city-2025" class="group bg-soho-white rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-navy">
          <div class="p-8">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-block px-3 py-1 bg-mcgennis-navy bg-opacity-10 text-mcgennis-navy text-xs font-semibold rounded-full">
                Business
              </span>
            </div>
            <h3 class="text-2xl font-display font-bold text-gray-900 tracking-tight group-hover:text-mcgennis-navy transition-colors mb-3">
              10 Thriving Businesses in Jefferson City
            </h3>
            <p class="text-gray-600 leading-relaxed mb-4 font-light">
              Discover the real businesses making waves in Jefferson City, Missouri in 2025.
            </p>
            <div class="flex items-center text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">
              Read More
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Leveraging Relationships Post -->
        <a href="/blog/entrepreneur-ai/leveraging-relationships-business-growth" class="group bg-soho-white rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-navy">
          <div class="p-8">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-block px-3 py-1 bg-mcgennis-navy bg-opacity-10 text-mcgennis-navy text-xs font-semibold rounded-full">
                Business
              </span>
            </div>
            <h3 class="text-2xl font-display font-bold text-gray-900 tracking-tight group-hover:text-mcgennis-navy transition-colors mb-3">
              Leveraging Relationships for Business Growth
            </h3>
            <p class="text-gray-600 leading-relaxed mb-4 font-light">
              Why who you know matters more than what you know in entrepreneurship.
            </p>
            <div class="flex items-center text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">
              Read More
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Fastest Growing Businesses Post -->
        <a href="/blog/entrepreneur-ai/fastest-growing-businesses-jefferson-city-2025" class="group bg-soho-white rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-mcgennis-navy">
          <div class="p-8">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-block px-3 py-1 bg-mcgennis-navy bg-opacity-10 text-mcgennis-navy text-xs font-semibold rounded-full">
                Business
              </span>
            </div>
            <h3 class="text-2xl font-display font-bold text-gray-900 tracking-tight group-hover:text-mcgennis-navy transition-colors mb-3">
              Fastest Growing Business Categories
            </h3>
            <p class="text-gray-600 leading-relaxed mb-4 font-light">
              Discover which industries are booming in Central Missouri's capital city.
            </p>
            <div class="flex items-center text-mcgennis-navy font-medium group-hover:text-mcgennis-gold transition-colors">
              Read More
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </a>
      </div>

      <div class="text-center mt-12">
        <a href="/blog/entrepreneur-ai" class="group inline-flex items-center px-8 py-4 border border-gray-300 text-gray-700 font-medium tracking-wide transition-all duration-300 hover:shadow-md rounded-xl">
          View All Business Posts
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Founder Section -->
  <section class="py-24 px-4 bg-soho-white">
    <div class="container mx-auto max-w-4xl">
      <div class="bg-soho-white p-10 hover:shadow-lg transition-all duration-300 border border-gray-200 rounded-2xl">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div>
            <svg class="w-24 h-24 text-mcgennis-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-3xl font-display font-bold mb-2 text-gray-900 tracking-tight">
              Meet The Founder
            </h2>
            <p class="text-xl text-gray-500 mb-4 font-light">
              <strong class="text-gray-900">Caleb Michael McGennis</strong> (dr4g0nbyt3) is the entrepreneurial force behind these ventures.
              With years of experience in technology, ministry, and business development, Caleb brings innovation
              and excellence to every project.
            </p>
            <a href="/family/caleb" class="group inline-flex items-center px-6 py-3 rounded-xl bg-mcgennis-navy text-white font-medium tracking-wide hover:bg-opacity-90 transition-all duration-300 shadow-sm hover:shadow-md">
              Learn More About Caleb
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-4 bg-soho-white border-t border-gray-200">
    <div class="container mx-auto text-center max-w-4xl">
      <h2 class="text-5xl font-display font-bold mb-4 text-gray-900 tracking-tight">Interested In Working Together?</h2>
      <div class="h-1 w-24 bg-brass-horizontal rounded-full shadow-sm mx-auto mb-8"></div>
      <p class="text-xl mb-12 text-gray-500 font-light">
        Reach out to discuss partnerships, collaborations, or learn more about our businesses
      </p>
      <a href="/contact" class="group inline-flex items-center justify-center px-8 py-4 rounded-xl bg-brass-button brightness-110 text-white font-medium tracking-wide hover:bg-opacity-90 transition-all duration-300 shadow-sm hover:shadow-md">
        Contact Us
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="sr-only">
    <h2>McGennis Family Businesses in Jefferson City, Missouri</h2>
    <p>
      Caleb Michael McGennis operates multiple successful businesses in Jefferson City, Missouri and beyond.
      His ventures include BXP (technology and innovation), The Honey Homestead (natural honey and homestead products),
      Bearded Digital (church website design), and What's the Process for (process management).
    </p>
    <p>
      Keywords: Jefferson City businesses, Missouri entrepreneurs, Caleb McGennis businesses, BXP Jefferson City,
      The Honey Homestead Missouri, Bearded Digital church websites, Jefferson City startups, Missouri business owners,
      dr4g0nbyt3 businesses, McGennis family enterprises
    </p>
  </section>
</BaseLayout>
