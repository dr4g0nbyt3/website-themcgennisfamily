---
import { formatDate, type Post } from '../data/posts';

interface Props {
  post: Post;
  showImage?: boolean;
}

const { post, showImage = true } = Astro.props;
const { category } = post;
---

<a
  href={post.url}
  data-category={category.slug}
  class={`post-card group flex flex-col bg-soho-white rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 border border-gray-200 ${category.hoverBorder}`}
>
  {showImage && (
    <div class="aspect-[16/10] overflow-hidden bg-gray-100">
      {post.image ? (
        <img
          src={post.image}
          alt=""
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class={`w-full h-full flex items-center justify-center p-8 text-center group-hover:scale-105 transition-transform duration-500 ${category.cover}`} aria-hidden="true">
          <span class="text-white/90 font-display font-bold text-2xl leading-snug">{category.name}</span>
        </div>
      )}
    </div>
  )}
  <div class="p-6 flex flex-col flex-1">
    <span class={`self-start inline-block px-3 py-1 text-xs font-semibold rounded-full mb-4 ${category.chip}`}>
      {category.name}
    </span>
    <h3 class={`text-xl font-display font-bold text-gray-900 tracking-tight transition-colors mb-3 ${category.hoverText}`}>
      {post.title}
    </h3>
    <p class="text-gray-600 leading-relaxed mb-4 font-light line-clamp-3">{post.description}</p>
    <div class="mt-auto flex items-center justify-between text-sm text-gray-500">
      <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
      <span>{post.author.split(' ')[0] === 'The' ? 'The Family' : post.author.split(' ')[0]}</span>
    </div>
  </div>
</a>
